{
  "name": "kely-local",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3130",
    "dev:worker": "tsx src/server/worker.ts",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "operator:access": "node --import tsx scripts/operator-access.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
